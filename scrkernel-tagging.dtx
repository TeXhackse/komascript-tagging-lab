%
% patch sectioning
%    \begin{macrocode}
\def\scrlab@notagstrut{%
  \ifhmode\else
  {\tagpdfparaOff
  \orig@strut}\par
  \fi
}
\AddtoDoHook{heading/preinit/part}{
  \let\orig@strut\strut\let\strut\scrlab@notagstrut
}
\AddtoDoHook{heading/begingroup/part}{
  \global\let\strut\orig@strut
}
\AddtoDoHook{heading/postinit}{
  \UseTaggingSocket{scr/sec/heading/init}
}
