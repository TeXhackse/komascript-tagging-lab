% \GetFileInfo{scrkernel-tagging.dtx}
% \title{Preparation for PDF Tagging}
% \author{\href{mailto:komascript@gmx.info}{Markus Kohm}}
% \date{Revision \fileversion{} of \filedate}
% \maketitle
% \begin{abstract}
%   \filename{} is used by generation of classes and packages for PDF tagging.
%   Note, that currently the file itself does not contain any code for PDF
%   tagging but for detection of PDF tagging and automatic loading of external
%   files if those are available.
% \end{abstract}
% \tableofcontents
%
% \section{User Manual}
%
% Currently not available.
%
% \MaybeStop{\PrintIndex}
%
% \section{Implementation of the Detection of Usage of Meta Data or Tagging}
%
% \changes{v3.49}{2025/09/11}{tagging warning added}
% \ExplSyntaxOn
% \begin{macro}{
%   \komascript_tagging_test:,
%   \komascript_documentmetadata_test:
% }
%   \ExplSyntaxOff
%   \changes{v3.49.3}{2026/06/13}{meta data error added}
%   \changes{v3.49.3}{2026/06/16}{moved to from
%     \file{scrkernel-miscellaneous.dtx}}
%   \changes{v3.49.3}{2026/06/16}{message module name expansion added}
%   In future \KOMAScript{} classes should support tagging, but currently they
%   don't. So if tagging is enabled, we warn. I expect the tagging support to
%   be added step by step. So the warning here will also change step by
%   step. However the name of the message used to warn, will not change. So
%   packages can add tagging support and also deactivate the message using
%\begin{verbatim}
%\msg_redirect_name:nnn { \KOMAClassName } { tagging-not-supported } { none }
%\end{verbatim}
%   As an alternative packages (and wrapper classes) can change the test and
%   messages by defining \cs{komascript_documentmetadata_test:}
%   resp. \cs{komascript_tagging_test:} before loading the \KOMAScript{}
%   class.
%   \changes{v3.49.3}{2026/09/22}{Fix typo in package loading}
%    \begin{macrocode}
%<*class>
\ExplSyntaxOn
%<*init>
\cs_if_exist:NF \komascript_documentmetadata_test:
  {
    \exp_args:NV \msg_new:nnn \KOMAClassName { metadata-not-supported }
      {
        \token_to_str:N\DocumentMetadata\ not~supported!\\
        Note:~This~class~currently~does~not~support~usage~of~
        \token_to_str:N\DocumentMetadata.\\
        Instead~of~using~\token_to_str:N\DocumentMetadata\ you~should~
        currently~use:\\
        \ \ \token_to_str:N\RequirePackage{pdfmanagement}\\
        \ \ \token_to_str:N\SetKeys[document/metadata]{...}\\
        before~\token_to_str:N\documentclass.
      }
    \cs_new:Npn \komascript_documentmetadata_test:
      {
        \cs_if_exist:NT \IfDocumentMetadataT
          {
            \IfDocumentMetadataT
              {
                \exp_args:NV \msg_fatal:nn \KOMAClassName
                  { metadata-not-supported }
              }
          }
      }
  }
%</init>
%<*verylate>
%    \begin{macrocode}
\IfDocumentMetadataT
  {
    \IfFileExists
%<article|book|report>      {scr-articlebookreport-tagging.sty}
%<letter>      {scr-letter-tagging.sty}
      {
        \RequirePackage
%<article|book|report>          {scr-articlebookreport-tagging}
%<letter>          {scr-letter-tagging}
      }
      {
        \InputIfFileExists
%<article|book|report>          {scr-articlebookreport-tagging-code.tex}
%<letter>          {scr-letter-tagging-code.tex}
          {}
          {\komascript_documentmetadata_test:}
      }
  }
%</verylate>
%<*init>
\cs_if_exist:NF \komascript_tagging_test:
  {
    \cs_new:Npn \komascript_tagging_test:
      {
        \cs_if_exist:NT \tag_if_active:T
          {
            \exp_args:NV \msg_new:nnn \KOMAClassName { tagging-not-supported }
              {
                Activated~tagging~detected~but~not~supported!\\
                Note:~This~class~currently~does~not~actively~support~tagging.~
                This~means:~Several~elements~will~not~be~tagged~correctly~
                and~also~several~errors~could~happen.\\
                Sorry!
              }
            \hook_gput_code:nnn { begindocument } { \KOMAClassName }
              {
                \tag_if_active:T
                  {
                    \exp_args:NV \msg_warning:nn
                      \KOMAClassName
                      { tagging-not-supported }
                  }
              }
          }
      }
  }
%</init>
%<verylate>\komascript_tagging_test:
\ExplSyntaxOff
%</class>
%    \end{macrocode}
%
% \section{Code created by the komascript-tagging-lab project}
%
% \changes{v3.49.4}{2026/10/31}{Move code of the komascript-tagging-lab project into \file{scrkernel-tagging}}
%    \begin{macrocode}
%<*init>
%<*tagging-lab>
%<@@=scrlab>
\ProvidesExplPackage {scr-articlebookreport-tagging}{v3.49.4}{2026/10/31}
%     \end{macrocode}
%
% Warning that tagging is generally supported but development in progress.
%    \begin{macrocode}
\exp_args:NV \msg_new:nnn \KOMAClassName { tagging-work-in-progress }
{
  Activated~tagging~detected~but~not~this~is~still~WIP.\\
  Use~at~your~own~risk~and~be~welcome~to~report~your~experiences.
}
\hook_gput_code:nnn { begindocument } { \KOMAClassName }{
  \tag_if_active:T
    {
      \exp_args:NV \msg_warning:nn
        \KOMAClassName
        { tagging-work-in-progress }
    }
}
\cs_set:Nn \komascript_tagging_test: {}
\cs_set:Nn \komascript_documentmetadata_test: {}

\int_new:N \l_@@_sec_level_int
\tl_new:N \l_@@_sec_tmpa_tl
\bool_new:N \l_@@_sec_nonumber_bool
\newcommand*{\NumDepth}[1]{\use:c {#1numdepth}}

\cs_new:Nn \_TEST_numdepth:n {
  \int_compare:nNnF {\use:c {toclevel@#1}} = {\NumDepth{#1}}{\PackageError{TESt}{Doesn't math \NumDepth{#1} -- \use:c {toclevel@#1} }}
}
%</tagging-lab>
%    \end{macrocode}
% \end{macro}
